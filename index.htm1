<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Gyanivo | ज्ञान से विकास की ओर</title>

  <meta name="description"
        content="Gyanivo पर बच्चों, विद्यार्थियों और शिक्षकों के लिए शिक्षा सामग्री, Worksheets, PDF और परीक्षा तैयारी सामग्री।">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, "Noto Sans Devanagari", sans-serif;
    }

    body {
      background: #f5f7fb;
      color: #222;
      line-height: 1.6;
    }

    header {
      background: linear-gradient(135deg, #1565c0, #42a5f5);
      color: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 30px;
      font-weight: bold;
    }

    .tagline {
      font-size: 13px;
      opacity: 0.95;
    }

    nav {
      margin-top: 8px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 7px;
      font-size: 15px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .hero {
      text-align: center;
      padding: 65px 20px;
      background: white;
    }

    .hero h1 {
      font-size: 42px;
      color: #1565c0;
      margin-bottom: 12px;
    }

    .hero p {
      font-size: 19px;
      color: #555;
      max-width: 700px;
      margin: auto;
    }

    .button {
      display: inline-block;
      margin-top: 25px;
      padding: 12px 25px;
      background: #1565c0;
      color: white;
      text-decoration: none;
      border-radius: 25px;
      font-weight: bold;
    }

    .section {
      padding: 45px 7%;
    }

    .section h2 {
      text-align: center;
      color: #1565c0;
      margin-bottom: 30px;
      font-size: 30px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 25px 18px;
      text-align: center;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .icon {
      font-size: 42px;
      margin-bottom: 10px;
    }

    .card h3 {
      color: #1565c0;
      margin-bottom: 8px;
    }

    .card p {
      color: #666;
      font-size: 14px;
    }

    .about {
      background: #eaf3ff;
      text-align: center;
      padding: 45px 8%;
    }

    .about h2 {
      color: #1565c0;
      margin-bottom: 15px;
    }

    .about p {
      max-width: 800px;
      margin: auto;
      color: #444;
    }

    footer {
      background: #12304a;
      color: white;
      text-align: center;
      padding: 25px;
      margin-top: 20px;
    }

    footer p {
      margin: 5px;
      font-size: 14px;
    }

    @media (max-width: 650px) {

      header {
        text-align: center;
        justify-content: center;
      }

      .logo {
        width: 100%;
        margin-bottom: 5px;
      }

      nav a {
        display: inline-block;
        margin: 5px;
      }

      .hero h1 {
        font-size: 32px;
      }

      .hero p {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>

  <!-- Header -->
  <header>

    <div>
      <div class="logo">📚 Gyanivo</div>
      <div class="tagline">ज्ञान से विकास की ओर</div>
    </div>

    <nav>
      <a href="#">होम</a>
      <a href="#classes">कक्षाएँ</a>
      <a href="#worksheets">वर्कशीट</a>
      <a href="#exams">परीक्षा</a>
      <a href="#teacher">शिक्षक कॉर्नर</a>
    </nav>

  </header>


  <!-- Hero Section -->
  <section class="hero">

    <h1>Gyanivo में आपका स्वागत है</h1>

    <p>
      बच्चों, विद्यार्थियों और शिक्षकों के लिए
      आसान, उपयोगी और गुणवत्तापूर्ण शिक्षा सामग्री।
    </p>

    <a href="#classes" class="button">
      पढ़ाई शुरू करें →
    </a>

  </section>


  <!-- Classes -->
  <section class="section" id="classes">

    <h2>📚 कक्षा के अनुसार पढ़ाई</h2>

    <div class="cards">

      <div class="card">
        <div class="icon">👦</div>
        <h3>कक्षा 1</h3>
        <p>हिन्दी, English, गणित और सामान्य ज्ञान।</p>
      </div>

      <div class="card">
        <div class="icon">📖</div>
        <h3>कक्षा 2</h3>
        <p>बुनियादी शिक्षा और अभ्यास सामग्री।</p>
      </div>

      <div class="card">
        <div class="icon">✏️</div>
        <h3>कक्षा 3–5</h3>
        <p>विषयवार प्रश्न और Worksheets।</p>
      </div>

      <div class="card">
        <div class="icon">🎓</div>
        <h3>कक्षा 6–8</h3>
        <p>विषयवार अध्ययन एवं परीक्षा तैयारी।</p>
      </div>

    </div>

  </section>


  <!-- Worksheets -->
  <section class="section" id="worksheets">

    <h2>📝 Worksheets और PDF</h2>

    <div class="cards">

      <div class="card">
        <div class="icon">📄</div>
        <h3>वर्कशीट</h3>
        <p>बच्चों के अभ्यास के लिए उपयोगी Worksheets।</p>
      </div>

      <div class="card">
        <div class="icon">📕</div>
        <h3>PDF सामग्री</h3>
        <p>पढ़ाई और अभ्यास के लिए PDF सामग्री।</p>
      </div>

      <div class="card">
        <div class="icon">🧮</div>
        <h3>गणित अभ्यास</h3>
        <p>सरल से कठिन प्रश्नों का अभ्यास।</p>
      </div>

      <div class="card">
        <div class="icon">🔤</div>
        <h3>English Grammar</h3>
        <p>हिन्दी के साथ आसान English Grammar।</p>
      </div>

    </div>

  </section>


  <!-- Exams -->
  <section class="section" id="exams">

    <h2>🎓 प्रतियोगी परीक्षा तैयारी</h2>

    <div class="cards">

      <div class="card">
        <div class="icon">📘</div>
        <h3>UPTET</h3>
        <p>UPTET के लिए अभ्यास प्रश्न और अध्ययन सामग्री।</p>
      </div>

      <div class="card">
        <div class="icon">📚</div>
        <h3>CTET</h3>
        <p>CTET की तैयारी के लिए उपयोगी सामग्री।</p>
      </div>

      <div class="card">
        <div class="icon">🧠</div>
        <h3>GK</h3>
        <p>सामान्य ज्ञान के महत्वपूर्ण प्रश्न।</p>
      </div>

    </div>

  </section>


  <!-- Teacher Corner -->
  <section class="about" id="teacher">

    <h2>👨‍🏫 शिक्षक कॉर्नर</h2>

    <p>
      Gyanivo शिक्षकों के लिए Lesson Plan, शिक्षण सामग्री,
      Worksheets, प्रश्न-पत्र, गतिविधियाँ और उपयोगी संसाधन
      उपलब्ध कराने का प्रयास है।
    </p>

  </section>


  <!-- Footer -->
  <footer>

    <h3>📚 Gyanivo</h3>

    <p>ज्ञान से विकास की ओर</p>

    <p>© 2026 Gyanivo. सभी अधिकार सुरक्षित।</p>

  </footer>

</body>
</html>
